{
  "name": "ziti-rom-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Custom ROM hub for the OnePlus Nord CE 3 5G (ziti). Git-backed content, no database.",
  "scripts": {
    "dev": "node scripts/copy-media.mjs && next dev",
    "build": "npm run validate-content && npm run generate-search-index && node scripts/copy-media.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "validate-content": "tsx scripts/validate-content.ts",
    "generate-search-index": "tsx scripts/generate-search-index.ts",
    "generate-sample-media": "bash scripts/generate-sample-media.sh"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^16.2.1",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.4",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
